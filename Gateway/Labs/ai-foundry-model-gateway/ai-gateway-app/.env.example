# Endpoint de tu instancia de Azure API Management (sin / al final)
APIM_ENDPOINT=https://apim-xxxxxxxxxxxxx.azure-api.net

# Subscription key / API key de APIM
APIM_SUBSCRIPTION_KEY=tu-api-key-aqui

# Nombre del deployment del modelo en Azure AI Foundry
MODEL_DEPLOYMENT=gpt-5.4-mini

# Versión de la API de Azure OpenAI que expone tu APIM
API_VERSION=2024-08-01-preview

# Precio de referencia en USD por cada 1000 tokens (ajusta a tu tarifa real)
PRICE_PROMPT_PER_1K=0.00015
PRICE_COMPLETION_PER_1K=0.0006

# Timeout de la petición al gateway, en segundos
REQUEST_TIMEOUT_SECONDS=30

# Puerto local del servidor Flask
PORT=5050
