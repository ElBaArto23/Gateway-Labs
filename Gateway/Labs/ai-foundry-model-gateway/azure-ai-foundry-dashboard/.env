# Foundry Project Endpoint del deployment de Lab A (ai-foundry-model-gateway),
# tomado de la salida real del notebook (celda "Get the deployment outputs").
AI_FOUNDRY_PROJECT_ENDPOINT=https://agents-foundry-tazvvonn4lhea.services.ai.azure.com/api/projects/foundry-project-agents-foundry

# Nombre del Persistent Agent ya creado por el notebook (celda 12).
AGENT_NAME=my-test-agent

# Puerto de App 1 (dashboard).
PORT=5050

# URL base de App 2 (ai-gateway-app), para que App 1 fusione sus métricas.
# App 2 corre en el puerto 5090 según su propio .env -- ajustá si lo cambiaste.
APP2_BASE_URL=http://localhost:5090

# ---------------------------------------------------------------------
# IMPORTANTE: esta app usa DefaultAzureCredential(), no una API key.
# Necesitás tener sesión activa en esta máquina con la MISMA cuenta que
# corrió el notebook (ycure@coem.co):
#     az login
# Sin eso, /api/chat va a fallar en la autenticación aunque el endpoint
# de arriba sea correcto.
